class Main {
    function void main() {
        var Conv c;
        var Array input5, filter, input9;
        var int i;

        let input5 = Array.new(25);
        let input5[0]  =  1;  let input5[1]  =  2;  let input5[2]  =  3;
        let input5[3]  =  4;  let input5[4]  =  5;
        let input5[5]  =  6;  let input5[6]  =  7;  let input5[7]  =  8;
        let input5[8]  =  9;  let input5[9]  = 10;
        let input5[10] = 11;  let input5[11] = 12;  let input5[12] = 13;
        let input5[13] = 14;  let input5[14] = 15;
        let input5[15] = 16;  let input5[16] = 17;  let input5[17] = 18;
        let input5[18] = 19;  let input5[19] = 20;
        let input5[20] = 21;  let input5[21] = 22;  let input5[22] = 23;
        let input5[23] = 24;  let input5[24] = 25;

        let filter = Array.new(9);
        let filter[0] =  0;  let filter[1] =  1;  let filter[2] =  0;
        let filter[3] =  1;  let filter[4] = -4;  let filter[5] =  1;
        let filter[6] =  0;  let filter[7] =  1;  let filter[8] =  0;

        let c = Conv.new(5);
        do c.initFilter(filter);
        do c.getArrayInput(input5, 5);
        do c.conv2d();

        do Output.printString("5x5 Conv Output (stride=1):");
        do Output.println();
        do c.printOutput();
        do Output.println();

        do c.dispose();
        do input5.dispose();
        do filter.dispose();

        let input9 = Array.new(81);
        let i = 0;
        while (i < 81) {
            let input9[i] = i + 1;
            let i = i + 1;
        }

        let filter = Array.new(9);
        let filter[0] =  0;  let filter[1] =  1;  let filter[2] =  0;
        let filter[3] =  1;  let filter[4] = -4;  let filter[5] =  1;
        let filter[6] =  0;  let filter[7] =  1;  let filter[8] =  0;

        let c = Conv.new(9);
        do c.dispose();

        let c = Conv.newWithStride(9, 2);
        do c.initFilter(filter);
        do c.getArrayInput(input9, 9);
        do c.conv2d();

        do Output.printString("9x9 Conv Output (stride=2):");
        do Output.println();
        do c.printOutput();

        do c.dispose();
        do input9.dispose();
        do filter.dispose();

        return;
    }
}